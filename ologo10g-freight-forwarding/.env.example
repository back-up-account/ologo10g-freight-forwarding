# Copy this file to .env.local for local development, or configure these keys in
# the hosting platform. Add only business details approved for publication.
# Blank public values intentionally leave the app's "to be confirmed" states visible.
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_BUSINESS_PHONE=
NEXT_PUBLIC_BUSINESS_EMAIL=
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_BUSINESS_ADDRESS=
NEXT_PUBLIC_BUSINESS_HOURS=
NEXT_PUBLIC_PORT_COVERAGE=

# Server-only Resend delivery settings. Configure as deployment secrets in production.
# Never use NEXT_PUBLIC_ for secrets or commit real values to this template.
RESEND_API_KEY=
ENQUIRY_FROM_EMAIL=
ENQUIRY_TO_EMAIL=
